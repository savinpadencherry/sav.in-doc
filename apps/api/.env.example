# Database
DATABASE_URL=sqlite:///./data/chainsync.db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# AI Models
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_PATH=./data/vector_store

# Route Optimization
MAX_VEHICLES=5
DEFAULT_SPEED_KMH=30

# Feature Flags
USE_LOCAL_ADAPTERS=true
# USE_AWS_ADAPTERS=false

# Optional AWS Configuration (commented out by default)
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=chainsync-data
# AWS_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/chainsync-events

# Observability
ENABLE_TRACING=false
LOG_LEVEL=INFO

# Security
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=jwt-secret-change-in-production